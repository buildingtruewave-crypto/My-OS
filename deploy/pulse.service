[Unit]
Description=PULSE Life OS (Streamlit)
After=network.target

[Service]
Type=simple
User=www-data
WorkingDirectory=/opt/pulse
Environment="PATH=/opt/pulse/venv/bin:/usr/local/bin:/usr/bin"
ExecStart=/opt/pulse/venv/bin/streamlit run app.py \
          --server.address=127.0.0.1 --server.port=8501 --server.headless=true
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
